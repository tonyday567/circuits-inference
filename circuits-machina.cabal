cabal-version: 3.0
name: circuits-machina
version: 0.1.0.0
license: BSD-3-Clause
license-file: LICENSE
copyright: Tony Day (c) 2026
category: math
author: Tony Day
maintainer: tonyday567@gmail.com
homepage: https://github.com/tonyday567/circuits-machina#readme
bug-reports: https://github.com/tonyday567/circuits-machina/issues
synopsis: Categorical deep learning checkbox — inference as Prob over Kleisli
description:
  Effectful probability row: Prob (Kleisli m) instances, terminating
  traces on samplers, and premonoidal witnesses. Frontier §4 first slice.

build-type: Simple
tested-with:
  ghc ==9.14.1

extra-doc-files:
  ChangeLog.md
  readme.md

source-repository head
  type: git
  location: https://github.com/tonyday567/circuits-machina

common ghc-options-stanza
  ghc-options:
    -Wall
    -Wno-unused-imports
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints

common ghc2024-stanza
  default-language: GHC2024

library
  import: ghc-options-stanza
  import: ghc2024-stanza
  hs-source-dirs: src
  exposed-modules:
    Circuit.Machina.Prob
    Circuit.Machina.Sampler
  build-depends:
    base >=4.18 && <5,
    circuits >=0.2 && <0.4,
    random >=1.2 && <1.4,

executable circuits-machina-axioma
  import: ghc-options-stanza
  import: ghc2024-stanza
  hs-source-dirs: app
  main-is: axioma.hs
  build-depends:
    base >=4.18 && <5,
    circuits,
    circuits-machina,
    containers >=0.6 && <0.8,
    random >=1.2 && <1.4,
    QuickCheck >=2.14 && <2.16,
