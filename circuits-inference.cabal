cabal-version: 3.0
name: circuits-inference
version: 0.1.0.0
license: BSD-3-Clause
license-file: LICENSE
copyright: Tony Day (c) 2026
category: math
author: Tony Day
maintainer: tonyday567@gmail.com
homepage: https://github.com/tonyday567/circuits-inference#readme
bug-reports: https://github.com/tonyday567/circuits-inference/issues
synopsis: Inference engines as functors from Prob
description:
  Effectful probability row: Prob (Kleisli m) instances, terminating
  traces on samplers, and premonoidal witnesses. Frontier §4 first slice.

build-type: Simple
tested-with:
  ghc ==9.10.1
  ghc ==9.12.2
  ghc ==9.14.1

extra-doc-files:
  ChangeLog.md
  readme.md

source-repository head
  type: git
  location: https://github.com/tonyday567/circuits-inference

common ghc-options-stanza
  ghc-options:
    -Wall
    -Wno-unused-imports
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints

library
  import: ghc-options-stanza
  default-language: GHC2024
  hs-source-dirs: src
  exposed-modules:
    Circuit.Inference.HMC
    Circuit.Inference.LinearSolve
    Circuit.Inference.Prob
    Circuit.Inference.Sampler
    Circuit.Inference.SMC

  build-depends:
    base >=4.20 && <5,
    circuits >=0.3 && <0.4,
    circuits-prob >=0.1 && <0.2,
    random >=1.2 && <1.4,

executable circuits-inference-axioma
  import: ghc-options-stanza
  default-language: GHC2024
  hs-source-dirs: app
  main-is: axioma.hs
  build-depends:
    base >=4.20 && <5,
    circuits,
    circuits-inference,
    containers >=0.6 && <0.9,
    random >=1.2 && <1.4,
